{
  "name": "chinspeak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build:content": "tsx scripts/build-content.ts",
    "build:icons": "tsx scripts/build-icons.cts",
    "build:tts": "tsx scripts/build-tts.ts",
    "verify:tts": "tsx scripts/verify-tts-coverage.ts",
    "test:meaning": "tsx --test scripts/meaning-units.test.ts",
    "test:study": "tsx --test scripts/study-content.test.ts",
    "test:recall": "tsx --test scripts/recall.test.ts",
    "test:grammar": "tsx --test scripts/grammar-notes.test.ts",
    "test:grammar-browser": "npm run build && tsx scripts/grammar-notes.browser.cts",
    "test:recall-manual": "npm run build && tsx scripts/recall-manual.browser.cts",
    "test:nav-resume": "npm run build && tsx scripts/bottom-nav-resume.browser.cts",
    "test:pwa": "npm run build && tsx scripts/pwa-updates.browser.cts",
    "test:follow": "npm run build && tsx scripts/playback-follow.browser.cts",
    "test:basic": "npm run build && tsx scripts/basic-mode.browser.cts",
    "test:learning-listening": "npm run build && tsx scripts/learning-listening.browser.cts",
    "build": "npm run build:content && tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@node-rs/jieba": "^2.0.4",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "msedge-tts": "^2.1.1",
    "pinyin-pro": "3.29.5",
    "playwright-core": "1.65.0",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3",
    "vite-plugin-pwa": "^0.20.5"
  }
}
